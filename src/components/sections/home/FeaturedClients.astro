---
import { Image } from 'astro:assets';
import restaurants from '../../../data/clients/restaurants.json';
import butchers from '../../../data/clients/butchers.json';
import { resolveImage } from '../../../utils/images';

const featured = [...restaurants, ...butchers].slice(0, 4);
---
<section class="clients section">
  <h2 data-aos="fade-up">Confían en nosotros</h2>
  <div class="clients__grid">
    {featured.map((c, i) => (
      <article class="clients__card" data-aos="fade-up" data-aos-delay={i * 100}>
        <Image src={resolveImage(c.image)} alt={c.name} width={400} height={400} />
        <h3>{c.name}</h3>
        <p class="clients__meta">{c.category} · {c.neighborhood}</p>
      </article>
    ))}
  </div>
  <p class="clients__more" data-aos="fade-up">
    <a class="btn btn--sky" href="/clients">Ver más clientes</a>
  </p>
</section>
<style>
  .clients {
    background: var(--color-brown);
    color: var(--color-white);
  }

  .clients__card {
    color: var(--color-brown);
  }

  .clients h2,
  .clients__more {
    text-align: center;
  }

  .clients__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-md);
    max-width: 1000px;
    margin: 0 auto;
  }

  .clients__card {
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-white);
    text-align: center;
  }

  .clients__card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .clients__card h3 {
    margin: var(--space-sm) var(--space-sm) 0;
  }

  .clients__meta {
    margin: 0.25rem var(--space-sm) var(--space-md);
    font-size: 0.9rem;
  }
</style>
