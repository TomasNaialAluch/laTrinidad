---
import { Image } from 'astro:assets';
import { resolveImage } from '../../../utils/images';

const photos = [1, 3, 5, 8, 11, 14].map((n) => resolveImage(`src/assets/store/${n}.jpeg`));
---
<section class="store section">
  <h2 data-aos="fade-up">Conocé el local</h2>
  <div class="store__grid">
    {photos.map((photo, i) => (
      <Image
        src={photo}
        alt="Foto del local de Frigorífico La Trinidad"
        width={480}
        height={360}
        data-aos="zoom-in"
        data-aos-delay={i * 80}
      />
    ))}
  </div>
  <p class="store__more" data-aos="fade-up">
    <a class="btn" href="/store">Ver más</a>
  </p>
</section>
<style>
  .store {
    background: var(--color-sky-light);
  }

  .store h2,
  .store__more {
    text-align: center;
  }

  .store__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-sm);
    max-width: 1000px;
    margin: 0 auto;
  }

  .store__grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 8px;
  }
</style>
