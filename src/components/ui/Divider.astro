---
const { from, to } = Astro.props;
---
<div class="divider" style={`background: ${from}`} aria-hidden="true">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
    <path
      style={`fill: ${to}`}
      d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z"
    />
  </svg>
</div>
<style>
  .divider {
    line-height: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: 60px;
  }
</style>
